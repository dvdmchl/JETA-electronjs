{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "locations", "characters"],
  "properties": {
    "metadata": {"$ref": "#/definitions/metadata"},
    "intro": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["page"], "properties": {"page": {"type": "string"}}}},
    "locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/location"}},
    "items": {"type": "array", "items": {"$ref": "#/definitions/item"}},
    "characters": {"type": "array", "items": {"$ref": "#/definitions/character"}},
    "variables": {"type": "array", "items": {"$ref": "#/definitions/variable"}},
    "endings": {"type": "array", "items": {"$ref": "#/definitions/ending"}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}
  },
  "definitions": {
    "booleanLike": {"anyOf": [{"type": "boolean"}, {"enum": ["true", "false"]}]},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["title", "language"],
      "properties": {"title": {"type": "string"}, "author": {"type": "string"}, "version": {"type": "string"}, "language": {"type": "string"}, "description": {"type": "string"}}
    },
    "description": {
      "type": "object", "additionalProperties": false,
      "properties": {"default": {"type": "string"}, "condition": {"type": "string"}, "description": {"type": "string"}},
      "anyOf": [{"required": ["default"]}, {"required": ["condition", "description"]}]
    },
    "descriptions": {"type": "array", "items": {"$ref": "#/definitions/description"}},
    "endingDescription": {
      "type": "object", "additionalProperties": false,
      "properties": {"default": {"type": "string"}, "condition": {"type": "string"}, "description": {"type": "string"}, "set": {"type": "string"}},
      "anyOf": [{"required": ["default"]}, {"required": ["condition", "description"]}]
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "properties": {"condition": {"type": "string"}, "description": {"type": "string"}, "default": {"type": "string"}, "set": {"type": "string"}},
      "anyOf": [{"required": ["description"]}, {"required": ["default"]}, {"required": ["set"]}]
    },
    "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}},
    "location": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "descriptions", "connections"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "name_accusative": {"type": "string"}, "descriptions": {"$ref": "#/definitions/descriptions"},
        "connections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["direction", "target"], "properties": {"direction": {"type": "string"}, "target": {"type": "string", "minLength": 1}}}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "descriptions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "name_accusative": {"type": "string"}, "descriptions": {"$ref": "#/definitions/descriptions"},
        "owner": {"type": ["string", "null"]}, "location": {"type": ["string", "null"]}, "visible": {"$ref": "#/definitions/booleanLike"}, "movable": {"$ref": "#/definitions/booleanLike"},
        "onUse": {"$ref": "#/definitions/actions"}, "onTake": {"$ref": "#/definitions/actions"}, "onDrop": {"$ref": "#/definitions/actions"}, "onSee": {"$ref": "#/definitions/actions"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string"}, "condition": {"type": "string"}, "set": {"type": "string"}, "next": {"type": "string"}}
    },
    "dialogue": {
      "type": "object", "additionalProperties": false, "required": ["description"],
      "properties": {"id": {"type": "string"}, "condition": {"type": "string"}, "description": {"type": "string"}, "set": {"type": "string"}, "responses": {"type": "array", "items": {"$ref": "#/definitions/response"}}}
    },
    "character": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "location"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "name_accusative": {"type": "string"}, "location": {"type": "string"}, "visible": {"$ref": "#/definitions/booleanLike"}, "descriptions": {"$ref": "#/definitions/descriptions"}, "onTalk": {"type": "array", "items": {"$ref": "#/definitions/dialogue"}}}
    },
    "variable": {
      "type": "object", "additionalProperties": false, "required": ["id", "value"],
      "properties": {"id": {"type": "string", "minLength": 1}, "value": {"type": ["string", "number", "boolean", "null"]}}
    },
    "ending": {
      "type": "object", "additionalProperties": false, "required": ["id", "descriptions"],
      "properties": {"id": {"type": "string", "minLength": 1}, "descriptions": {"type": "array", "items": {"$ref": "#/definitions/endingDescription"}}}
    }
  }
}
